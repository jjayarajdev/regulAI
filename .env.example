# Neo4j — pick one option
#
# Option A: Local Docker (default for development)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=regulai-dev-password
NEO4J_DATABASE=neo4j
#
# Option B: Neo4j Aura (cloud). Copy values from your Aura instance file:
#   - NEO4J_URI       = neo4j+s://<instance-id>.databases.neo4j.io
#   - NEO4J_USER      = <instance-id>     (Aura calls this NEO4J_USERNAME — same value)
#   - NEO4J_PASSWORD  = <generated password>
#   - NEO4J_DATABASE  = <instance-id>     (Aura Free uses the instance ID, not "neo4j")

# Data engine — which warehouse the RHS pipeline queries.
#   snowflake (default) → packages/rhs/snowflake_client (needs SNOWFLAKE_* below)
#   duckdb              → packages/rhs/duckdb_client — free, local, no billing.
#                         Build the file first: `uv run python -m scripts.seed_duckdb`
#   databricks          → planned
REGULAI_DB=snowflake
# REGULAI_DUCKDB_PATH=materialized/regulai.duckdb   # override the duckdb file location

# OpenAI (Sentinel agent — fill in your key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Tunables (all overridable, no buried hardcoded constants)
SENTINEL_CONFIDENCE_THRESHOLD=0.75
BRIDGE_CONFIDENCE_THRESHOLD=0.85
COVERAGE_ADVISORY_ONLY=true
MATERIALIZED_DIR=materialized

# ────────────────────────────────────────────────────────────────────
# Snowflake — used by the RHS pipeline. Required for `make load-bronze`,
# `/api/rhs/validate`, the admin/upload Dagster job. On a dev laptop
# you can skip these and use `~/.snowflake/config.toml` instead (the
# `snow` CLI's config); inside Docker / AWS, set them here.
# ────────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Pick ONE auth path:
#   (a) PAT (recommended for this account):
SNOWFLAKE_TOKEN=
SNOWFLAKE_AUTHENTICATOR=PROGRAMMATIC_ACCESS_TOKEN
#   (b) password (alternative):
# SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=INSURANCE_REGULATORY

# ────────────────────────────────────────────────────────────────────
# Production overlay (docker-compose.prod.yml + Caddy) — only set
# these if you're deploying with HTTPS on a real domain.
# ────────────────────────────────────────────────────────────────────
# The hostname Caddy serves on. Leave commented for local dev.
# REGULAI_DOMAIN=demo.example.com
# Email address Let's Encrypt uses for cert-expiry notifications.
# REGULAI_ACME_EMAIL=ops@example.com
