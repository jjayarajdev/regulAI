# Neo4j (LHS KG store, Docker local)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=regulai-dev-password
NEO4J_DATABASE=neo4j

# OpenAI (Sentinel agent — fill in your key)
OPENAI_API_KEY=
